<script>
// ── Load data from JSON tag ──
var data = JSON.parse(document.getElementById('tripData').textContent);

var currentDay = 1;
var editMode = false;
var editingItemKey = null;
var editingMetroKey = null;
var editingQRId = null;

var METRO_COLORS = ['#e74c3c','#e67e22','#f39c12','#2ecc71','#16a085','#3498db','#2980b9','#9b59b6','#e91e63','#607d8b'];
var TAG_NAMES = {transport:'交通',food:'美食',sight:'景點',stay:'住宿',shop:'購物',festival:'祭典'};

var qrItems = [
  {id:1, name:'日光東照宮門票', desc:'成人票 1300円', date:'Day 3 · 5/14', img:null},
  {id:2, name:'晴空塔展望台', desc:'天望廊 300m 2100円', date:'Day 4 · 5/15', img:null},
  {id:3, name:'忍者寺（妙立寺）', desc:'預約票 1000円', date:'Day 8 · 5/19', img:null}
];

// ── Day Chips ──
function renderDayChips() {
  var wrap = document.getElementById('dayChips');
  var html = '';
  for (var i = 1; i <= 17; i++) {
    var d = data.days[String(i)];
    var has = d && ((d.items && d.items.length > 0) || (d.transit && d.transit.length > 0));
    html += '<div class="day-chip' + (i === currentDay ? ' active' : '') + (has ? ' has-content' : '') + '" onclick="selectDay(' + i + ')">';
    html += '<span class="chip-label">DAY</span><span class="chip-num">' + i + '</span>';
    if (has) html += '<div class="chip-dot"></div>';
    html += '</div>';
  }
  wrap.innerHTML = html;
}

function selectDay(n) {
  currentDay = n;
  renderDayChips();
  renderDayContent();
  setTimeout(function() {
    var chips = document.querySelectorAll('.day-chip');
    if (chips[n-1]) chips[n-1].scrollIntoView({behavior:'smooth', block:'nearest', inline:'center'});
  }, 50);
}

// ── Day Content ──
function renderDayContent() {
  var wrap = document.getElementById('dayContent');
  var day = data.days[String(currentDay)];
  var dateDay = 11 + currentDay;
  var totalCost = 0;
  if (day) {
    (day.items || []).forEach(function(it) { totalCost += (it.cost || 0); });
    (day.transit || []).forEach(function(tr) {
      (tr.lines || []).forEach(function(l) { totalCost += (parseInt(l.fare) || 0); });
    });
  }
  var html = '<div class="day-header">';
  html += '<div><div class="day-number">DAY ' + currentDay + '</div>';
  html += '<div class="day-main-title">' + (day ? day.title : '待規劃') + '</div>';
  html += '<div class="day-date">2025年5月' + dateDay + '日' + (day && day.subtitle ? ' · ' + day.subtitle : '') + '</div></div>';
  html += '<div><div class="total-label">預算合計</div><div class="total-amount">¥' + totalCost.toLocaleString() + '</div></div></div>';
  html += '<div class="itinerary-list">' + buildItems(day) + '</div>';
  html += '<button class="add-btn" onclick="openAddItem()">＋ 新增行程項目</button>';
  html += '<button class="add-metro-btn" onclick="openAddMetro()">🚇 新增交通路線</button>';
  wrap.innerHTML = html;
}

function buildItems(day) {
  if (!day) return '<div class="empty"><div class="ei">✏️</div><p>這天還沒有行程<br>點底部＋新增！</p></div>';
  var all = [];
  (day.transit || []).forEach(function(t) { all.push({type:'metro', data:t, st:t.time||'00:00'}); });
  (day.items || []).forEach(function(it) { all.push({type:'item', data:it, st:it.time||'00:00'}); });
  all.sort(function(a,b) { return a.st < b.st ? -1 : 1; });
  if (!all.length) return '<div class="empty"><div class="ei">✏️</div><p>這天還沒有行程<br>點底部＋新增！</p></div>';
  var html = '';
  for (var i = 0; i < all.length; i++) {
    var isLast = (i === all.length - 1);
    if (all[i].type === 'metro') html += buildMetroCard(all[i].data, isLast);
    else html += buildItemCard(all[i].data, isLast);
  }
  return html;
}

function buildItemCard(item, isLast) {
  var sn = item.subnotes || [];
  var snHtml = '';
  if (sn.length > 0) {
    snHtml = '<div class="sub-notes">';
    for (var i = 0; i < sn.length; i++) {
      snHtml += '<div class="sub-note"><span class="snb">&#9670;</span>' + sn[i] + '</div>';
    }
    snHtml += '</div>';
  }
  var mapBtn = item.location ? '<button class="mapbtn" onclick="openMap(\'' + escJ(item.location) + '\',\'' + escJ(item.name) + '\')">📍</button>' : '';
  var editBtns = editMode ? '<div class="edit-btns"><button class="ebtn" onclick="openEdit(' + currentDay + ',' + item.id + ')">✏️ 編輯</button><button class="dbtn" onclick="deleteItem(' + currentDay + ',' + item.id + ')">🗑</button></div>' : '';
  var html = '<div class="item-row">';
  html += '<div class="time-col">';
  html += item.time ? '<div class="time-bubble">' + item.time + '</div>' : '<div style="height:20px"></div>';
  if (!isLast) html += '<div class="time-line"></div>';
  html += '</div>';
  html += '<div class="item-body-col"><div class="item-card' + (editMode ? ' em' : '') + '" id="item-' + item.id + '">';
  html += '<div class="ici">';
  html += '<div class="item-top">';
  html += item.tag ? '<span class="item-tag tag-' + item.tag + '">' + (TAG_NAMES[item.tag] || item.tag) + '</span>' : '<span></span>';
  html += item.cost > 0 ? '<span class="item-cost">¥' + item.cost.toLocaleString() + '</span>' : '<span></span>';
  html += '</div>';
  html += '<div class="inr"><span class="item-name">' + item.name + '</span>' + mapBtn + '</div>';
  if (item.note) html += '<div class="item-note">' + item.note + '</div>';
  html += snHtml + '</div>';
  html += editBtns + '</div></div></div>';
  return html;
}

function buildMetroCard(metro, isLast) {
  var totalFare = 0;
  (metro.lines || []).forEach(function(l) { totalFare += (parseInt(l.fare) || 0); });
  var linesHtml = '';
  (metro.lines || []).forEach(function(l) {
    linesHtml += '<div class="mli">';
    linesHtml += '<span class="mlb" style="background:' + (l.color||'#333') + ';color:white">' + l.badge + '</span>';
    linesHtml += '<span class="mld">' + (l.desc||'') + '</span>';
    if (parseInt(l.fare) > 0) linesHtml += '<span class="mlf">¥' + parseInt(l.fare).toLocaleString() + '</span>';
    linesHtml += '</div>';
  });
  var editBtns = editMode ? '<div class="metro-ebtns"><button class="mebtn" onclick="openEditMetro(' + currentDay + ',\'' + metro.id + '\')">✏️ 編輯</button><button class="mebtn d" onclick="deleteMetro(' + currentDay + ',\'' + metro.id + '\')">🗑 刪除</button></div>' : '';
  var html = '<div class="item-row">';
  html += '<div class="time-col">';
  html += metro.time ? '<div class="time-bubble metro-t">' + metro.time + '</div>' : '<div style="height:20px"></div>';
  if (!isLast) html += '<div class="time-line" style="background:rgba(230,92,0,.2)"></div>';
  html += '</div>';
  html += '<div class="item-body-col"><div class="metro-card' + (editMode ? ' em' : '') + '" id="metro-' + metro.id + '">';
  html += '<div class="mh"><span class="mi">🚇</span><span class="mt">' + metro.title + '</span>';
  if (totalFare > 0) html += '<span class="mf">¥' + totalFare.toLocaleString() + '</span>';
  html += '</div><div class="ml">' + linesHtml + '</div>';
  if (metro.note) html += '<div class="mn">' + metro.note + '</div>';
  html += editBtns + '</div></div></div>';
  return html;
}

function escJ(s) {
  return (s||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/"/g,'\\"');
}

// ── Edit Mode ──
function toggleEdit() {
  editMode = !editMode;
  var fab = document.getElementById('fabEdit');
  if (editMode) { fab.classList.add('on'); fab.textContent = '✅'; }
  else { fab.classList.remove('on'); fab.textContent = '✏️'; }
  renderDayContent();
}

// ── Map ──
function openMap(loc, name) {
  document.getElementById('mapTitle').textContent = '📍 ' + name;
  var q = encodeURIComponent(loc + ' Japan');
  document.getElementById('mapFrame').src = 'https://maps.google.com/maps?q=' + q + '&output=embed&hl=zh-TW&zoom=15';
  document.getElementById('mapModal').classList.add('open');
}
function closeMap() {
  document.getElementById('mapModal').classList.remove('open');
  setTimeout(function() { document.getElementById('mapFrame').src = 'about:blank'; }, 400);
}

// ── Item Edit ──
function openEdit(dayNum, itemId) {
  var day = data.days[String(dayNum)];
  var item = null;
  for (var i = 0; i < day.items.length; i++) { if (day.items[i].id === itemId) { item = day.items[i]; break; } }
  if (!item) return;
  editingItemKey = {dayNum:dayNum, itemId:itemId};
  buildEditForm('編輯行程', item);
}
function openAddItem() {
  editingItemKey = null;
  buildEditForm('新增行程', {time:'',name:'',note:'',cost:0,tag:'sight',location:'',subnotes:[]});
}
function buildEditForm(title, item) {
  document.getElementById('editTitle').textContent = title;
  var tags = ['transport','food','sight','stay','shop','festival'];
  var tagNames = {transport:'🚆 交通',food:'🍜 美食',sight:'🗼 景點',stay:'🏨 住宿',shop:'🛍 購物',festival:'🎉 祭典'};
  var sn = item.subnotes || [];
  var snHtml = '';
  for (var i = 0; i < sn.length; i++) {
    snHtml += '<div class="snrow" id="snr-' + i + '"><input class="fi" value="' + sn[i].replace(/"/g,'&quot;') + '"><button type="button" class="rmsn" onclick="rmSN(' + i + ')">✕</button></div>';
  }
  var tagOpts = '';
  for (var j = 0; j < tags.length; j++) {
    tagOpts += '<button type="button" class="tag-opt' + (item.tag === tags[j] ? ' sel' : '') + '" data-tag="' + tags[j] + '" onclick="selTag(this)">' + tagNames[tags[j]] + '</button>';
  }
  var html = '<div class="frow"><div class="fg"><label class="fl">時間</label><input class="fi" id="ef-time" placeholder="10:00" value="' + (item.time||'') + '"></div>';
  html += '<div class="fg"><label class="fl">費用 (円)</label><input class="fi" id="ef-cost" type="number" placeholder="0" value="' + (item.cost||0) + '"></div></div>';
  html += '<div class="fg"><label class="fl">名稱</label><input class="fi" id="ef-name" placeholder="行程名稱" value="' + (item.name||'').replace(/"/g,'&quot;') + '"></div>';
  html += '<div class="fg"><label class="fl">備注</label><textarea class="fta" id="ef-note">' + (item.note||'') + '</textarea></div>';

html += ‘<div class="fg"><label class="fl">地點（地圖用，建議加日文）</label><input class=“fi” id=“ef-loc” placeholder=“例：浅草寺 東京都” value=”’ + (item.location||’’).replace(/”/g,’"’) + ‘”></div>’;
html += ‘<div class="fg"><label class="fl">類型</label><div class="tag-select">’ + tagOpts + ‘</div></div>’;
html += ‘<div class="fg"><label class="fl">小備注（口袋名單、注意事項）</label><div class="sne" id="snEditor">’ + snHtml + ‘</div>’;
html += ‘<button type="button" class="addsn" onclick="addSN()">＋ 新增小備注</button></div>’;
html += ‘<button class="save-btn" onclick="saveItem()">💾 儲存</button>’;
if (editingItemKey) html += ‘<button class="del-btn" onclick="delItem()">🗑 刪除此項目</button>’;
document.getElementById(‘editForm’).innerHTML = html;
document.getElementById(‘editModal’).classList.add(‘open’);
}
function addSN() {
var ed = document.getElementById(‘snEditor’);
var i = ed.querySelectorAll(’.snrow’).length;
ed.insertAdjacentHTML(‘beforeend’, ‘<div class="snrow" id="snr-' + i + '"><input class="fi" placeholder="備注內容"><button type="button" class="rmsn" onclick="rmSN(' + i + ')">✕</button></div>’);
}
function rmSN(i) { var r = document.getElementById(‘snr-’ + i); if (r) r.remove(); }
function selTag(btn) {
var opts = document.querySelectorAll(’.tag-opt’);
for (var i = 0; i < opts.length; i++) opts[i].classList.remove(‘sel’);
btn.classList.add(‘sel’);
}
function saveItem() {
var time = document.getElementById(‘ef-time’).value.trim();
var name = document.getElementById(‘ef-name’).value.trim();
var note = document.getElementById(‘ef-note’).value.trim();
var cost = parseInt(document.getElementById(‘ef-cost’).value) || 0;
var loc = document.getElementById(‘ef-loc’).value.trim();
var tagEl = document.querySelector(’.tag-opt.sel’);
var tag = tagEl ? tagEl.getAttribute(‘data-tag’) : ‘sight’;
if (!name) { alert(‘請輸入行程名稱’); return; }
var snInputs = document.querySelectorAll(’#snEditor input’);
var subnotes = [];
for (var i = 0; i < snInputs.length; i++) { var v = snInputs[i].value.trim(); if (v) subnotes.push(v); }
var dayKey = String(editingItemKey ? editingItemKey.dayNum : currentDay);
if (editingItemKey) {
var items = data.days[dayKey].items;
for (var j = 0; j < items.length; j++) {
if (items[j].id === editingItemKey.itemId) {
items[j].time = time; items[j].name = name; items[j].note = note;
items[j].cost = cost; items[j].location = loc; items[j].tag = tag; items[j].subnotes = subnotes;
break;
}
}
} else {
if (!data.days[dayKey]) data.days[dayKey] = {title:‘第’+currentDay+‘天’,subtitle:’’,transit:[],items:[]};
data.days[dayKey].items.push({id:Date.now(),time:time,name:name,note:note,cost:cost,location:loc,tag:tag,subnotes:subnotes});
}
closeEdit(); renderDayChips(); renderDayContent(); updateOverview();
}
function deleteItem(dayNum, itemId) {
if (!confirm(‘確定要刪除？’)) return;
var dayKey = String(dayNum);
data.days[dayKey].items = data.days[dayKey].items.filter(function(i) { return i.id !== itemId; });
renderDayChips(); renderDayContent(); updateOverview();
}
function delItem() {
if (!editingItemKey || !confirm(‘確定刪除？’)) return;
var dayKey = String(editingItemKey.dayNum);
var id = editingItemKey.itemId;
data.days[dayKey].items = data.days[dayKey].items.filter(function(i) { return i.id !== id; });
closeEdit(); renderDayChips(); renderDayContent(); updateOverview();
}
function closeEdit() { document.getElementById(‘editModal’).classList.remove(‘open’); editingItemKey = null; }

// ── Metro Edit ──
function openAddMetro() {
editingMetroKey = null;
buildMetroForm(‘新增交通路線’, {title:’’,time:’’,note:’’,lines:[{badge:’’,color:’#e74c3c’,desc:’’,fare:’’}]});
}
function openEditMetro(dayNum, metroId) {
var day = data.days[String(dayNum)];
var metro = null;
for (var i = 0; i < day.transit.length; i++) { if (day.transit[i].id === metroId) { metro = day.transit[i]; break; } }
if (!metro) return;
editingMetroKey = {dayNum:dayNum, metroId:metroId};
buildMetroForm(‘編輯交通路線’, metro);
}
function buildMetroForm(title, metro) {
document.getElementById(‘metroTitle’).textContent = title;
var lines = metro.lines || [{badge:’’,color:’#e74c3c’,desc:’’,fare:’’}];
var lHtml = ‘’;
for (var i = 0; i < lines.length; i++) lHtml += mlRowHTML(lines[i], i);
var html = ‘<div class="frow"><div class="fg" style="flex:2"><label class="fl">路線標題</label><input class=“fi” id=“mf-title” placeholder=“例：南千住 到 上野” value=”’ + (metro.title||’’).replace(/”/g,’"’) + ‘”></div>’;
html += ‘<div class="fg"><label class="fl">時間</label><input class="fi" id="mf-time" placeholder="09:00" value="' + (metro.time||'') + '"></div></div>’;
html += ‘<div class="fg"><label class="fl">備注</label><input class=“fi” id=“mf-note” placeholder=“乘車備注” value=”’ + (metro.note||’’).replace(/”/g,’"’) + ‘”></div>’;
html += ‘<div class="fg"><label class="fl">路線明細（可新增換乘）</label><div class="mle" id="mlEditor">’ + lHtml + ‘</div>’;
html += ‘<button type="button" class="addml" onclick="addML()">＋ 新增換乘路線</button></div>’;
html += ‘<button class="save-btn" onclick="saveMetro()">💾 儲存</button>’;
if (editingMetroKey) html += ‘<button class="del-btn" onclick="delMetro()">🗑 刪除此路線</button>’;
document.getElementById(‘metroForm’).innerHTML = html;
document.getElementById(‘metroModal’).classList.add(‘open’);
}
function mlRowHTML(l, i) {
var pres = ‘’;
for (var ci = 0; ci < METRO_COLORS.length; ci++) {
pres += ‘<div class="cp' + (l.color === METRO_COLORS[ci] ? ' sel' : '') + '" style="background:' + METRO_COLORS[ci] + '" data-color="' + METRO_COLORS[ci] + '" onclick="selMC(' + i + ',this)"></div>’;
}
return ‘<div class="mlrow" id="mlr-' + i + '"><div class="mlrt"><input class=“fi” style=“flex:1” id=“mlb-’ + i + ‘” placeholder=“線名 e.g.日比谷線” value=”’ + (l.badge||’’).replace(/”/g,’"’) + ‘”><input class="fi" style="width:65px" id="mlf-' + i + '" type="number" placeholder="円" value="' + (l.fare||'') + '"><button type="button" class="rmml" onclick="rmML(' + i + ')">✕</button></div><input class=“fi” id=“mld-’ + i + ‘” placeholder=“說明 e.g.南千住→上野（5分）” value=”’ + (l.desc||’’).replace(/”/g,’"’) + ‘”><div class="cps" id="mlc-' + i + '">’ + pres + ‘</div></div>’;
}
function addML() {
var ed = document.getElementById(‘mlEditor’);
var i = ed.querySelectorAll(’.mlrow’).length;
ed.insertAdjacentHTML(‘beforeend’, mlRowHTML({badge:’’,color:METRO_COLORS[i % METRO_COLORS.length],desc:’’,fare:’’}, i));
}
function rmML(i) { var r = document.getElementById(‘mlr-’ + i); if (r) r.remove(); }
function selMC(i, el) {
var cps = document.getElementById(‘mlc-’ + i).querySelectorAll(’.cp’);
for (var j = 0; j < cps.length; j++) cps[j].classList.remove(‘sel’);
el.classList.add(‘sel’);
}
function getMLs() {
var rows = document.querySelectorAll(’#mlEditor .mlrow’);
var result = [];
for (var i = 0; i < rows.length; i++) {
var ri = rows[i].id.replace(‘mlr-’,’’);
var sc = rows[i].querySelector(’.cp.sel’);
var badge = document.getElementById(‘mlb-’ + ri) ? document.getElementById(‘mlb-’ + ri).value.trim() : ‘’;
if (!badge) continue;
result.push({badge:badge, desc:(document.getElementById(‘mld-’ + ri)||{}).value||’’, fare:(document.getElementById(‘mlf-’ + ri)||{}).value||’’, color:sc?sc.getAttribute(‘data-color’):’#333’});
}
return result;
}
function saveMetro() {
var title = document.getElementById(‘mf-title’).value.trim();
var time = document.getElementById(‘mf-time’).value.trim();
var note = document.getElementById(‘mf-note’).value.trim();
var lines = getMLs();
if (!title) { alert(‘請輸入路線標題’); return; }
var dayKey = String(editingMetroKey ? editingMetroKey.dayNum : currentDay);
if (!data.days[dayKey].transit) data.days[dayKey].transit = [];
if (editingMetroKey) {
var tr = data.days[dayKey].transit;
for (var i = 0; i < tr.length; i++) {
if (tr[i].id === editingMetroKey.metroId) { tr[i].title=title; tr[i].time=time; tr[i].note=note; tr[i].lines=lines; break; }
}
} else {
data.days[dayKey].transit.push({id:‘t’+Date.now(),title:title,time:time,note:note,lines:lines});
}
closeMetro(); renderDayChips(); renderDayContent(); updateOverview();
}
function deleteMetro(dayNum, metroId) {
if (!confirm(‘確定刪除？’)) return;
var dayKey = String(dayNum);
data.days[dayKey].transit = data.days[dayKey].transit.filter(function(t) { return t.id !== metroId; });
renderDayChips(); renderDayContent(); updateOverview();
}
function delMetro() {
if (!editingMetroKey || !confirm(‘確定刪除？’)) return;
var dayKey = String(editingMetroKey.dayNum);
var mid = editingMetroKey.metroId;
data.days[dayKey].transit = data.days[dayKey].transit.filter(function(t) { return t.id !== mid; });
closeMetro(); renderDayChips(); renderDayContent(); updateOverview();
}
function closeMetro() { document.getElementById(‘metroModal’).classList.remove(‘open’); editingMetroKey = null; }

// ── QR ──
function renderQR() {
var html = ‘’;
for (var i = 0; i < qrItems.length; i++) {
var q = qrItems[i];
html += ‘<div class="qr-card"><div class="qr-ph" title="點擊上傳圖片">’;
html += q.img ? ‘<img src="' + q.img + '" alt="QR">’ : ‘🎫’;
html += ‘<input type="file" accept="image/*" onchange="uploadQR(' + q.id + ',this)"></div>’;
html += ‘<div class="qr-info"><div class="qr-name">’ + q.name + ‘</div><div class="qr-desc">’ + q.desc + ‘</div><div class="qr-date">’ + q.date + ‘</div>’;
html += ‘<div class="qr-acts"><button class="qr-eb" onclick="openEditQR(' + q.id + ')">✏️ 編輯</button><button class="qr-db" onclick="deleteQR(' + q.id + ')">🗑 刪除</button></div>’;
html += ‘</div></div>’;
}
document.getElementById(‘qrGrid’).innerHTML = html;
}
function uploadQR(id, input) {
var file = input.files[0]; if (!file) return;
var r = new FileReader();
r.onload = function(e) {
for (var i = 0; i < qrItems.length; i++) { if (qrItems[i].id === id) { qrItems[i].img = e.target.result; break; } }
renderQR();
};
r.readAsDataURL(file);
}
function openAddQR() { editingQRId = null; buildQRForm(‘新增票券’, {name:’’,desc:’’,date:’’}); }
function openEditQR(id) {
var item = null;
for (var i = 0; i < qrItems.length; i++) { if (qrItems[i].id === id) { item = qrItems[i]; break; } }
if (!item) return;
editingQRId = id;
buildQRForm(‘編輯票券’, item);
}
function buildQRForm(title, item) {
document.getElementById(‘qrModalTitle’).textContent = title;
var html = ‘<div class="fg"><label class="fl">票券名稱</label><input class=“fi” id=“qf-name” placeholder=“例：日光東照宮門票” value=”’ + (item.name||’’).replace(/”/g,’"’) + ‘”></div>’;
html += ‘<div class="fg"><label class="fl">說明</label><input class=“fi” id=“qf-desc” placeholder=“例：成人票 1300円” value=”’ + (item.desc||’’).replace(/”/g,’"’) + ‘”></div>’;
html += ‘<div class="fg"><label class="fl">使用日</label><input class=“fi” id=“qf-date” placeholder=“例：Day 3 · 5/14” value=”’ + (item.date||’’).replace(/”/g,’"’) + ‘”></div>’;
html += ‘<button class="save-btn" onclick="saveQR()">💾 儲存</button>’;
if (editingQRId) html += ‘<button class="del-btn" onclick="delQR()">🗑 刪除</button>’;
document.getElementById(‘qrForm’).innerHTML = html;
document.getElementById(‘qrModal’).classList.add(‘open’);
}
function saveQR() {
var name = document.getElementById(‘qf-name’).value.trim();
var desc = document.getElementById(‘qf-desc’).value.trim();
var date = document.getElementById(‘qf-date’).value.trim();
if (!name) { alert(‘請輸入票券名稱’); return; }
if (editingQRId) {
for (var i = 0; i < qrItems.length; i++) { if (qrItems[i].id === editingQRId) { qrItems[i].name=name; qrItems[i].desc=desc; qrItems[i].date=date; break; } }
} else {
qrItems.push({id:Date.now(),name:name,desc:desc,date:date,img:null});
}
closeQRModal(); renderQR();
}
function deleteQR(id) {
if (!confirm(‘確定刪除？’)) return;
qrItems = qrItems.filter(function(q) { return q.id !== id; });
renderQR();
}
function delQR() {
if (!editingQRId || !confirm(‘確定刪除？’)) return;
var id = editingQRId;
qrItems = qrItems.filter(function(q) { return q.id !== id; });
closeQRModal(); renderQR();
}
function closeQRModal() { document.getElementById(‘qrModal’).classList.remove(‘open’); editingQRId = null; }

// ── Tab ──
function switchTab(tab) {
var tabs = [‘itinerary’,‘overview’,‘qr’];
for (var i = 0; i < tabs.length; i++) {
document.getElementById(‘panel-’ + tabs[i]).classList.toggle(‘active’, tabs[i] === tab);
document.getElementById(‘tab-’ + tabs[i]).classList.toggle(‘active’, tabs[i] === tab);
}
document.getElementById(‘fabGroup’).style.display = tab === ‘itinerary’ ? ‘flex’ : ‘none’;
}

// ── Overview ──
function updateOverview() {
var total = 0, spots = 0;
var keys = Object.keys(data.days);
for (var i = 0; i < keys.length; i++) {
var d = data.days[keys[i]];
(d.items||[]).forEach(function(it) { total += (it.cost||0); spots++; });
(d.transit||[]).forEach(function(tr) { (tr.lines||[]).forEach(function(l) { total += (parseInt(l.fare)||0); }); });
}
var e1 = document.getElementById(‘totalBudget’); if (e1) e1.textContent = ‘¥’ + total.toLocaleString();
var e2 = document.getElementById(‘totalSpots’); if (e2) e2.textContent = spots;
}

// ── Util ──
function oc(e, id, fn) { if (e.target === document.getElementById(id)) fn(); }

// ── Init ──
renderDayChips();
renderDayContent();
renderQR();
updateOverview();
setTimeout(function() {
var c = document.querySelectorAll(’.day-chip’);
if (c[0]) c[0].scrollIntoView({inline:‘start’});
}, 100);
</script>

