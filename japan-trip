<style>
:root{--ink:#1a1410;--paper:#faf7f2;--cream:#f0ebe0;--accent:#c0392b;--gold:#c9a84c;--muted:#8a7e72;--soft:#e8e0d0;--green:#3d7a5c;--blue:#2c5f8a;--metro:#e65c00;}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
body{background:var(--cream);font-family:'Noto Sans TC',sans-serif;color:var(--ink);min-height:100vh;max-width:430px;margin:0 auto;padding-bottom:72px;}
.panel{display:none;}.panel.active{display:block;}
.app-header{background:var(--ink);color:var(--paper);padding:18px 18px 0;position:sticky;top:0;z-index:100;}
.header-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;}
.trip-title{font-family:'Playfair Display',serif;font-size:22px;letter-spacing:1px;color:var(--gold);}
.trip-subtitle{font-size:10px;color:var(--muted);margin-top:2px;letter-spacing:2px;text-transform:uppercase;}
.header-badge{background:var(--accent);color:white;font-size:10px;padding:4px 10px;border-radius:20px;font-weight:700;}
.tab-bar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:430px;background:var(--ink);display:flex;border-top:1px solid rgba(255,255,255,0.08);z-index:100;}
.tab-btn{flex:1;background:none;border:none;color:var(--muted);font-family:'Noto Sans TC',sans-serif;font-size:11px;padding:10px 4px;cursor:pointer;position:relative;transition:color .2s;display:flex;flex-direction:column;align-items:center;gap:3px;}
.tab-btn .ti{font-size:18px;}
.tab-btn.active{color:var(--gold);}
.tab-btn.active::after{content:'';position:absolute;top:0;left:25%;right:25%;height:2px;background:var(--gold);border-radius:0 0 2px 2px;}
.day-selector-wrap{padding:12px 16px 0;overflow-x:auto;white-space:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
.day-selector-wrap::-webkit-scrollbar{display:none;}
.region-label{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:6px;display:block;}
.day-chips{display:inline-flex;gap:6px;padding-bottom:10px;}
.day-chip{display:inline-flex;flex-direction:column;align-items:center;background:white;border:1.5px solid var(--soft);border-radius:12px;padding:5px 9px;cursor:pointer;transition:all .18s;min-width:48px;}
.day-chip.active{background:var(--ink);border-color:var(--ink);color:white;}
.day-chip.active .chip-num{color:var(--gold);}
.day-chip.has-content{border-color:var(--gold);}
.chip-label{font-size:8px;color:var(--muted);letter-spacing:1px;}
.day-chip.active .chip-label{color:rgba(255,255,255,.5);}
.chip-num{font-size:14px;font-weight:700;}
.chip-dot{width:4px;height:4px;border-radius:50%;background:var(--gold);margin-top:2px;}
.day-chip.active .chip-dot{background:var(--accent);}
